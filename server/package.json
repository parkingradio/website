{
  "name": "server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../.env src/index.ts",
    "build": "tsc -p tsconfig.json && npm run typecheck",
    "typecheck": "tsc -p tsconfig.test.json",
    "start": "node --env-file=../.env dist/index.js",
    "create-admin": "tsx --env-file=../.env src/create-admin.ts",
    "generate:openapi": "tsx src/generate-openapi.ts",
    "check:openapi": "tsx src/generate-openapi.ts --check",
    "test": "vitest run",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1140.0",
    "@aws-sdk/client-secrets-manager": "^3.1139.0",
    "@aws-sdk/client-sesv2": "^3.1119.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "@fastify/swagger": "^9.9.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@node-oauth/oauth2-server": "^5.3.1",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "entities": "^8.1.0",
    "fastify": "^5.12.6",
    "fastify-type-provider-zod": "^7.0.0",
    "jose": "^6.2.10",
    "pg": "^8.23.0",
    "pg-connection-string": "^2.14.0",
    "pino": "^10.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.9.0",
    "globals": "^17.11.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.12"
  }
}
