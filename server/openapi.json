          "status": {
            "type": "string",
            "enum": [
              "active",
              "invited",
              "expired"
            ]
          },
          "inviteExpiresAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "invitedBy": {
            "type": [
              "string",
              "null"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "you": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "email",
          "status",
          "inviteExpiresAt",
          "invitedBy",
          "createdAt",
          "you"
        ],
        "additionalProperties": false
      },
      "ApiError": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "const": false
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "ok",
          "error"
        ],
        "additionalProperties": false
      },
