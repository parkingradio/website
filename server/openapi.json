        },
        "required": [
          "id",
          "enabled",
          "updatedBy",
          "updatedAt"
        ],
        "additionalProperties": false
      },
      "FeatureId": {
        "type": "string",
        "enum": [
          "nouveau-formulaire-candidature",
          "nouveau-lecteur"
        ]
