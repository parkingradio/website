        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true
          },
          "email": {
            "type": "string"
          }
        },
        "required": [
          "ok",
          "email"
        ],
        "additionalProperties": false
      },
      "Ok": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "ok"
        ],
        "additionalProperties": false
      }
    }
