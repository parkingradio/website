DATABASE_URL=postgres://parking_radio:parking_radio@localhost:5432/parking_radio
PORT=3000
JWT_SECRET=dev-only-insecure-secret-do-not-use-in-prod
ASSETS_DOMAIN=assets.parking.radio
# Where the app keeps its private files, e.g. artists' photos: either PRIVATE_BUCKET, its S3 bucket, or
# PRIVATE_BUCKET_DIRECTORY, a local directory that stands in for it. One of the two is required.
PRIVATE_BUCKET_DIRECTORY=private-bucket
# The keys of the Cloudflare Turnstile widget that keeps bots from sending applications. These are Cloudflare's test
# keys: every visitor passes, and the widget always gives the token "XXXX.DUMMY.TOKEN.XXXX". The server still sends
# tokens to Cloudflare to check them. See https://developers.cloudflare.com/turnstile/troubleshooting/testing/
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
