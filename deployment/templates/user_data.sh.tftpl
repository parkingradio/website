#!/bin/bash
set -euo pipefail

dnf install -y docker jq
systemctl enable --now docker

# Docker Compose is pinned for reproducibility. To upgrade, update the version and the
# checksum from https://github.com/docker/compose/releases.
COMPOSE_VERSION=v5.5.1
COMPOSE_SHA256=732e3a84c1a0f67256ce80bc2598a24546b10ca05f9faa97efceb1171ece2ef7
mkdir -p /usr/libexec/docker/cli-plugins
curl -fsSL "https://github.com/docker/compose/releases/download/$COMPOSE_VERSION/docker-compose-linux-aarch64" \
  -o /usr/libexec/docker/cli-plugins/docker-compose
echo "$COMPOSE_SHA256  /usr/libexec/docker/cli-plugins/docker-compose" | sha256sum --check --quiet
chmod +x /usr/libexec/docker/cli-plugins/docker-compose

mkdir -p /opt/app/certs

# Fetch the RDS Postgres certificate so we can talk to the DB using TLS.
curl -sSL -o /opt/app/certs/rds-global-bundle.pem https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem

cat > /opt/app/docker-compose.yml <<'COMPOSE_EOF'
${compose_file}
COMPOSE_EOF

cat > /opt/app/nginx.conf <<'NGINX_EOF'
${nginx_conf}
NGINX_EOF

SECRET_JSON=$(aws secretsmanager get-secret-value --secret-id "${secret_arn}" --region ${aws_region} \
  --query SecretString --output text)
JWT_SECRET=$(echo "$SECRET_JSON" | jq -r '.jwt_secret')
BOOTSTRAP_ADMIN_PASSWORD=$(echo "$SECRET_JSON" | jq -r '.bootstrap_admin_password')
SOUNDCLOUD_CLIENT_SECRET=$(echo "$SECRET_JSON" | jq -r '.soundcloud_client_secret')
TURNSTILE_SECRET_KEY=$(echo "$SECRET_JSON" | jq -r '.turnstile_secret_key')

cat > /opt/app/.env <<EOF
DATABASE_URL=postgres://${db_username}@${db_endpoint}/${db_name}
DATABASE_PASSWORD_SECRET_ID=${db_secret_arn}
DATABASE_SSL_CA=/app/certs/rds-global-bundle.pem
PORT=3000
AWS_REGION=${aws_region}
MAIL_DOMAIN=${domain}
ASSETS_DOMAIN=${assets_domain}
PRIVATE_BUCKET=${private_bucket}
JWT_SECRET=$JWT_SECRET
BOOTSTRAP_ADMIN_EMAIL=${bootstrap_admin_email}
BOOTSTRAP_ADMIN_PASSWORD=$BOOTSTRAP_ADMIN_PASSWORD
SOUNDCLOUD_CLIENT_ID=${soundcloud_client_id}
SOUNDCLOUD_CLIENT_SECRET=$SOUNDCLOUD_CLIENT_SECRET
TURNSTILE_SITE_KEY=${turnstile_site_key}
TURNSTILE_SECRET_KEY=$TURNSTILE_SECRET_KEY
EOF
chmod 600 /opt/app/.env

echo "$SECRET_JSON" | jq -r '.certificate' > /opt/app/certs/origin.pem
echo "$SECRET_JSON" | jq -r '.private_key' > /opt/app/certs/origin.key
chmod 600 /opt/app/certs/origin.key

cd /opt/app
docker compose pull
docker compose up -d
