{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    // Playwright resolves imports itself, as bundlers do.
    "moduleResolution": "Bundler",
    "types": ["node"],
    // Only type-checks: Playwright runs the sources itself.
    "noEmit": true,
    "strict": true,
    "verbatimModuleSyntax": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true
  },
  "include": ["playwright.config.ts", "env.ts", "tests"]
}
